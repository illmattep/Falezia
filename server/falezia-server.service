# /etc/systemd/system/falezia-server.service
# systemctl daemon-reload && systemctl enable --now falezia-server
[Unit]
Description=Falezia dedicato (UDP 27015)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=falezia
Group=falezia
WorkingDirectory=/opt/falezia
ExecStart=/usr/bin/dotnet /opt/falezia/Falezia.Server.dll --port=27015 --max=10
Restart=always
RestartSec=2
# niente privilegi, niente accesso al resto del sistema
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/falezia
Environment=DOTNET_EnableDiagnostics=0

[Install]
WantedBy=multi-user.target
