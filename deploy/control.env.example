# /etc/falezia/control.env — letto da systemd, non metterlo nel repo
#
# Il token lo genera il primo avvio in /var/lib/falezia/control.json, ma qui
# lo fissi tu (consigliato: così sopravvive a un ripristino della cartella dati).
FALEZIA_CONTROL_TOKEN=cambiami-32-caratteri-casuali

# Pannello
FALEZIA_CONTROL_BIND=0.0.0.0
FALEZIA_CONTROL_PORT=8090

# Quello che il client deve usare per raggiungere le partite
FALEZIA_PUBLIC_HOST=203.0.113.10

# Limite rigido: ON di default, 2 istanze
FALEZIA_HARD_LIMIT=true
FALEZIA_HARD_LIMIT_MAX=2
